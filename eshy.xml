<mujoco model="techtalkies">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  
  <default>
    <joint damping="0.05" armature="0.005" limited="true"
           solimplimit="0.95 0.99 0.001" solreflimit="0.002 1"/>
    <geom friction="1.0 0.05 0.001" contype="1" conaffinity="1"/>
  </default>
  
  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance=".2"/>
  </asset>

  <!--
    =================================================================
    COLLISION FIX
    =================================================================
    MuJoCo's default collision mode ("predefined") automatically
    suppresses contacts between geoms that share a close ancestor in
    the kinematic tree.  All four legs hang directly off the torso, so
    foot-to-foot contacts were silently disabled regardless of the
    contype/conaffinity bits.

    Fix: declare every foot-pair explicitly with <contact><pair>.
    This bypasses the ancestor filter for exactly those six pairs while
    leaving shaft-on-shaft pass-through intact (intentional — crossed
    legs won't jam).  Zero extra CPU cost for pairs not listed here.
    =================================================================
  -->
  <contact>
    <pair geom1="FL_foot" geom2="FR_foot"/>
    <pair geom1="FL_foot" geom2="BL_foot"/>
    <pair geom1="FL_foot" geom2="BR_foot"/>
    <pair geom1="FR_foot" geom2="BL_foot"/>
    <pair geom1="FR_foot" geom2="BR_foot"/>
    <pair geom1="BL_foot" geom2="BR_foot"/>
  </contact>

  <worldbody>
    <light name="light1" pos="0 0 2" dir="0 0 -1" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid"/>

    <body name="torso" pos="0 0 0.045">
      <freejoint/>
      <site name="imu_site" pos="0 0 0.01"/>
      <camera name="track"   mode="trackcom" pos="0.25 -0.4 0.25"  xyaxes="1 0.5 0 -0.2 0.4 0.9"/>
      <camera name="side"    mode="trackcom" pos="0.25  0.4 0.25"  xyaxes="-1 0.5 0 -0.2 -0.4 0.9"/>
      <camera name="topdown" mode="trackcom" pos="0 0 0.4"          xyaxes="1 0 0 0 1 0"/>

      <!-- Torso box: 89 × 58.6 × 37.2 mm.  140 g -->
      <geom name="torso_geom" type="box" size="0.0445 0.0293 0.0186"
            rgba=".3 .3 .7 1" mass="0.140" contype="3" conaffinity="3"/>
      <!-- Nose indicator (visual only, no collision) -->
      <geom type="sphere" pos="0.04 0 0.015" size="0.005"
            rgba="1 0 0 1" mass="0.0001" contype="0" conaffinity="0"/>

      <!-- ── FRONT-LEFT ─────────────────────────────────────────── -->
      <body name="FL_leg" pos="0.0228 0.0293 -0.015">
        <joint name="FL_hip" type="hinge" axis="0 -1 0" range="-90 90"/>
        <!-- shaft: no collision (contype=0) so legs can cross freely -->
        <geom name="FL_geom" type="box" size="0.006 0.003 0.017" pos="0 0 -0.012"
              rgba=".8 .3 .3 1" mass="0.00060" contype="0" conaffinity="0"/>
        <!-- foot: collides with floor AND other feet via <contact><pair> -->
        <geom name="FL_foot" type="cylinder"
              fromto="0 -0.003 -0.029  0 0.003 -0.029" size="0.006"
              rgba=".2 .2 .2 1" mass="0.00040" friction="1.2 0.1 0.001"
              contype="7" conaffinity="7"/>
      </body>

      <!-- ── FRONT-RIGHT ────────────────────────────────────────── -->
      <body name="FR_leg" pos="0.0228 -0.0293 -0.015">
        <joint name="FR_hip" type="hinge" axis="0 -1 0" range="-90 90"/>
        <geom name="FR_geom" type="box" size="0.006 0.003 0.017" pos="0 0 -0.012"
              rgba=".8 .3 .3 1" mass="0.00060" contype="0" conaffinity="0"/>
        <geom name="FR_foot" type="cylinder"
              fromto="0 -0.003 -0.029  0 0.003 -0.029" size="0.006"
              rgba=".2 .2 .2 1" mass="0.00040" friction="1.2 0.1 0.001"
              contype="7" conaffinity="7"/>
      </body>

      <!-- ── BACK-LEFT ──────────────────────────────────────────── -->
      <body name="BL_leg" pos="-0.0228 0.0293 -0.015">
        <joint name="BL_hip" type="hinge" axis="0 -1 0" range="-90 90"/>
        <geom name="BL_geom" type="box" size="0.006 0.003 0.017" pos="0 0 -0.012"
              rgba=".3 .3 .8 1" mass="0.00060" contype="0" conaffinity="0"/>
        <geom name="BL_foot" type="cylinder"
              fromto="0 -0.003 -0.029  0 0.003 -0.029" size="0.006"
              rgba=".3 .3 .8 1" mass="0.00040" friction="1.2 0.1 0.001"
              contype="7" conaffinity="7"/>
      </body>

      <!-- ── BACK-RIGHT ─────────────────────────────────────────── -->
      <body name="BR_leg" pos="-0.0228 -0.0293 -0.015">
        <joint name="BR_hip" type="hinge" axis="0 -1 0" range="-90 90"/>
        <geom name="BR_geom" type="box" size="0.006 0.003 0.017" pos="0 0 -0.012"
              rgba=".3 .3 .8 1" mass="0.00060" contype="0" conaffinity="0"/>
        <geom name="BR_foot" type="cylinder"
              fromto="0 -0.003 -0.029  0 0.003 -0.029" size="0.006"
              rgba=".3 .3 .8 1" mass="0.00040" friction="1.2 0.1 0.001"
              contype="7" conaffinity="7"/>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- MG90S stall torque: 1.8 kg·cm = 0.176 N·m -->
    <position name="FL_act" joint="FL_hip" ctrlrange="-90 90" forcerange="-0.18 0.18" kp="1.0" kv="0.10"/>
    <position name="FR_act" joint="FR_hip" ctrlrange="-90 90" forcerange="-0.18 0.18" kp="1.0" kv="0.10"/>
    <position name="BL_act" joint="BL_hip" ctrlrange="-90 90" forcerange="-0.18 0.18" kp="1.0" kv="0.10"/>
    <position name="BR_act" joint="BR_hip" ctrlrange="-90 90" forcerange="-0.18 0.18" kp="1.0" kv="0.10"/>
  </actuator>

  <sensor>
    <framequat    name="torso_quat" objtype="body" objname="torso"/>
    <framepos     name="torso_pos"  objtype="body" objname="torso"/>
    <gyro         name="torso_gyro" site="imu_site"/>
    <accelerometer name="torso_acc" site="imu_site"/>
  </sensor>

</mujoco>