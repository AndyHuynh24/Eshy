# Target
CONFIG_IDF_TARGET="esp32s3"

# Bluetooth / NimBLE — peripheral mode only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Larger default ATT MTU so one notify fits an R:/P:/Y:/S: frame
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128

# Run BLE host on APP CPU so the IMU loop on PRO CPU isn't preempted
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# Don't spam the console with host logs
CONFIG_BT_NIMBLE_LOG_LEVEL_WARN=y
